# Databricks workspace connection
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=<personal-access-token>
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>

# Unity Catalog location for this app's tables
DATABRICKS_CATALOG=insenio
DATABRICKS_SCHEMA=campus_lab_match

# Genie Space — NL queries over labs/lab_required_skills tables
GENIE_LAB_SPACE_ID=

# Foundation Model API — chat endpoint powering intake conversation + Apply Assist
FOUNDATION_MODEL_ENDPOINT=databricks-meta-llama-3-3-70b-instruct
EMBEDDING_MODEL_ENDPOINT=databricks-gte-large-en

# Vector Search — semantic interest-alignment over labs.research_focus
VECTOR_SEARCH_ENDPOINT_NAME=insenio-vs-endpoint
VECTOR_SEARCH_INDEX_NAME=

# Backend auth
JWT_SECRET=change-me-to-a-random-string
